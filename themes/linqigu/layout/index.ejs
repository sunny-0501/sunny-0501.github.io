<%
  const posts = site.posts.sort('date', -1).toArray().filter((post) => post.archived !== true);
  const categoryCount = (name) => posts.filter((post) => post.categories.toArray().some((category) => category.name === name)).length;
  const totalWords = posts.reduce((sum, post) => sum + (post.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, '').length, 0);
%>
<%- partial('_partial/document-start') %>
<main class="journal-home" id="top" tabindex="-1">
  <section class="voyage-hero" aria-labelledby="homeTitle">
    <div class="voyage-hero__copy">
      <h1 id="homeTitle">你好，我是 sunny。</h1>
      <p class="voyage-hero__description">白天做产品，下班后写点东西。<br />这里有读书笔记、工作记录，也有一些日常。</p>
      <div class="voyage-hero__actions"><a class="journal-button" href="#articles">看文章 <span aria-hidden="true">↓</span></a><button class="journal-text-button" type="button" data-boarding-open hidden>登船画面 <span aria-hidden="true">→</span></button></div>
    </div>
    <div class="voyage-hero__window">
      <img class="voyage-hero__art" src="<%- url_for('/images/header-landscape.png') %>" alt="蓝天下，少女撑着阳伞在开满野花的草坡上作画" width="1536" height="1024" fetchpriority="high" />
      <div class="voyage-hero__wash" aria-hidden="true"></div>
      <span class="journal-stamp" aria-hidden="true">風の便り<small>GHIBLI HOUSEBOAT</small></span>
      <span class="houseboat-breeze" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <div class="voyage-hero__ticket" aria-hidden="true"><img src="<%- url_for('/images/ghibli-houseboat-logo.svg') %>" alt="" width="44" height="44" /><span>吉卜力画舫<small>GHIBLI HOUSEBOAT</small></span><i>〰</i></div>
  </section>
  <section class="content-layout journal-content" id="articles">
    <div class="articles-column">
      <div class="journal-section-title"><h2>最近写的</h2><a href="<%- url_for('/archives/') %>">全部文章 <span aria-hidden="true">↗</span></a></div>
      <div class="home-article-toolbar">
        <nav class="content-tabs" aria-label="按分类浏览文章"><a class="selected" aria-current="true" href="<%- url_for('/') %>" data-filter="all"><span>全部</span><b><%= posts.length %></b></a><a href="<%- url_for('/categories/项目/') %>" data-filter="项目"><span>项目</span><b><%= categoryCount('项目') %></b></a><a href="<%- url_for('/categories/随笔/') %>" data-filter="随笔"><span>随笔</span><b><%= categoryCount('随笔') %></b></a><a href="<%- url_for('/categories/阅读/') %>" data-filter="阅读"><span>阅读</span><b><%= categoryCount('阅读') %></b></a></nav>
        <%- partial('_partial/article-layout-options') %>
      </div>
      <p class="journal-count filter-hint" id="filterHint" aria-live="polite">共 <%= posts.length %> 篇文章</p>
      <div class="article-list" id="articleList"><%- partial('_partial/article-row', { posts: posts }) %></div>
      <p class="empty-state" id="emptyState" hidden>没有找到匹配的文章。</p>
    </div>
    <aside class="sidebar journal-sidebar">
      <section class="sidebar-card profile-card">
        <div class="profile-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" width="112" height="112" loading="lazy" /></div>
        <div class="profile-identity"><h2>sunny</h2><span>产品 · 阅读 · 日常</span><p>这个博客用来整理笔记，<br />也记下平时想说的话。</p></div>
        <a class="profile-more" href="<%- url_for('/explore/') %>">关于我 <span aria-hidden="true">↗</span></a>
        <div class="site-stats"><div><strong><%= posts.length %></strong><span>篇文章</span></div><div><strong><%= totalWords.toLocaleString('zh-CN') %></strong><span>字</span></div></div>
      </section>
      <a class="journal-small-world" href="<%- url_for('/gallery/') %>"><img src="<%- url_for('/images/forest-rest.png') %>" alt="树影里的休息时光" loading="lazy" width="480" height="360" /><span><strong>相册</strong><i aria-hidden="true">↗</i></span></a>
    </aside>
  </section>
  <section class="journal-wander" id="voyage" aria-label="随风漫游"><%- partial('_partial/voyage') %></section>
  <section class="newsletter" id="newsletter"><div><h2>有更新时，RSS 见。</h2><p>把订阅地址加进你常用的阅读器。</p></div><a class="read-link newsletter-link" href="<%- url_for('/rss/') %>">订阅 RSS <span aria-hidden="true">↗</span></a><%- partial('_partial/houseboat-vignette') %></section>
</main>
<%- partial('_partial/document-end') %>
