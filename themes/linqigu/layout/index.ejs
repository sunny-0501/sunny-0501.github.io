<%
  const posts = site.posts.sort('date', -1).toArray().filter((post) => post.archived !== true);
  const featured = posts[0];
  const categoryCount = (name) => posts.filter((post) => post.categories.toArray().some((category) => category.name === name)).length;
  const totalWords = posts.reduce((sum, post) => sum + (post.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, '').length, 0);
  const startYear = posts.length ? new Date(posts[posts.length - 1].date).getFullYear() : new Date().getFullYear();
%>
<%- partial('_partial/document-start') %>
<main id="top" tabindex="-1">
  <div class="houseboat-welcome">
    <p class="houseboat-welcome__note"><svg class="houseboat-welcome__leaf" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false"><path d="M6 19C3 10 10 4 23 5c0 12-6 18-14 15" fill="currentColor" fill-opacity=".12" /><path d="M5 24 20 9M6 19C3 10 10 4 23 5c0 12-6 18-14 15M12 17l-1-6m6 1h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg><span class="houseboat-welcome__copy">慢慢写，慢慢航行。<span class="houseboat-welcome__japanese" lang="ja">風にまかせて、ゆっくりと。</span></span></p>
    <span class="houseboat-welcome__route"><span>日常</span><i aria-hidden="true"></i><span>阅读</span><i aria-hidden="true"></i><span>远方</span></span>
  </div>
  <section class="dashboard-hero" aria-label="博客首页">
    <article class="quote-card" aria-label="吉卜力画舫随笔">
      <div class="quote-controls" role="tablist" aria-label="切换随笔">
        <button class="quote-control is-active" id="quote-tab-1" type="button" role="tab" aria-selected="true" aria-controls="quote-slide-1" aria-label="显示第一则随笔"><span></span></button>
        <button class="quote-control" id="quote-tab-2" type="button" role="tab" aria-selected="false" aria-controls="quote-slide-2" aria-label="显示第二则随笔" tabindex="-1"><span></span></button>
      </div>
      <div class="quote-slides" aria-live="polite">
        <section class="quote-slide is-active" id="quote-slide-1" role="tabpanel" aria-labelledby="quote-tab-1"><p class="eyebrow">PERSONAL NOTES</p><h2 class="quote-text">念念不忘，<br />必有回响。</h2><p class="quote-site">GHIBLI HOUSEBOAT</p></section>
        <section class="quote-slide quote-slide--long" id="quote-slide-2" role="tabpanel" aria-labelledby="quote-tab-2" aria-hidden="true" inert><p class="eyebrow">PERSONAL NOTES</p><h2 class="quote-text">身如柳絮随风扬，<br />无论云泥意贯一。</h2><p class="quote-site">GHIBLI HOUSEBOAT</p></section>
      </div>
      <%- partial('_partial/houseboat-vignette') %>
    </article>
    <% if (featured) { %>
      <a class="photo-card" href="<%- url_for(featured.path) %>" aria-label="阅读最新文章"><img src="<%- url_for('/images/header-landscape.png') %>" alt="晴天下的草坡与画画的人" /><div class="photo-shade"></div><span class="houseboat-breeze" aria-hidden="true"><i></i><i></i><i></i></span><span class="houseboat-postmark" aria-hidden="true"><span lang="ja">風の便り</span><small>SLOW DAYS</small></span><div class="photo-copy"><span>最新文章 · <%= featured.categories.length ? featured.categories.first().name : '随笔' %></span><h2><%= featured.title %></h2></div><span class="recommend">↗ 阅读全文</span></a>
    <% } %>
  </section>
  <section class="content-layout" id="articles">
    <aside class="sidebar">
      <div class="sidebar-card profile-card">
        <div class="profile-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" /></div>
        <div class="profile-identity"><p class="mini-heading">ABOUT THE AUTHOR</p><h2>sunny</h2><i></i><span>INFJ</span><p>一个在互联网行业工作、下班后写字的人。相信好奇心、长期主义，还有一杯热茶。</p></div>
        <div class="profile-socials" aria-label="联系 sunny"><a href="https://github.com/sunny-0501" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><span aria-hidden="true">&lt;/&gt;</span></a></div>
        <div class="site-stats" aria-label="站点统计"><div><strong><%= posts.length %></strong><span>篇文章</span></div><div><strong><%= totalWords.toLocaleString('zh-CN') %></strong><span>字数</span></div><div><strong><%= Math.max(1, new Date().getFullYear() - startYear + 1) %></strong><span>记录年</span></div></div>
        <a class="profile-more" href="<%- url_for('/explore/') %>">认识我更多 <span>↗</span></a>
      </div>
    </aside>
    <div class="articles-column">
      <div class="home-article-toolbar">
        <nav class="content-tabs" aria-label="按分类浏览文章"><a class="selected" aria-current="true" href="<%- url_for('/') %>" data-filter="all"><span>全部</span><b><%= posts.length %></b></a><a href="<%- url_for('/categories/项目/') %>" data-filter="项目"><span>项目</span><b><%= categoryCount('项目') %></b></a><a href="<%- url_for('/categories/随笔/') %>" data-filter="随笔"><span>随笔</span><b><%= categoryCount('随笔') %></b></a><a href="<%- url_for('/categories/阅读/') %>" data-filter="阅读"><span>阅读</span><b><%= categoryCount('阅读') %></b></a></nav>
        <%- partial('_partial/article-layout-options') %>
      </div>
      <div class="section-heading"><h2 class="section-label"><span>LATEST NOTES</span><span>最新文章</span></h2><p class="filter-hint" id="filterHint" aria-live="polite">共 <%= posts.length %> 篇文章 · 可按上方分类查找</p></div>
      <div class="article-list" id="articleList"><%- partial('_partial/article-row', { posts: posts }) %></div>
      <p class="empty-state" id="emptyState" hidden>没有找到匹配的文章。</p>
    </div>
  </section>
  <nav class="quick-links" aria-label="快捷入口"><a href="<%- url_for('/archives/') %>"><span aria-hidden="true">01 · <span lang="ja">日々の記録</span></span><strong>全部文章</strong><i aria-hidden="true">↗</i></a><a href="<%- url_for('/links/') %>"><span aria-hidden="true">02 · <span lang="ja">ご縁をたどって</span></span><strong>友链往来</strong><i aria-hidden="true">↗</i></a><a href="<%- url_for('/explore/') %>"><span aria-hidden="true">03 · <span lang="ja">わたしのこと</span></span><strong>我的</strong><i aria-hidden="true">↗</i></a></nav>
  <section class="newsletter" id="newsletter"><div><p class="eyebrow houseboat-newsletter-note" lang="ja">また、次の便りで。</p><h2>下次更新，继续相遇。</h2><p>通过 RSS 订阅，在你习惯的阅读器里收到新文章。</p></div><a class="read-link newsletter-link" href="<%- url_for('/rss/') %>">订阅更新 <span>↗</span></a></section>
</main>
<%- partial('_partial/document-end') %>
