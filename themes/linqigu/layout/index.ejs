<% const posts = site.posts.sort('date', -1).toArray(); %>
<% const featured = posts[0]; %>
<%- partial('_partial/document-start') %>
<main id="top">
  <section class="wallpaper-heading" aria-label="林栖谷">
    <p>LINQI VALLEY</p>
    <strong>林栖谷</strong>
    <span>把走过的路，写成可以回看的光。</span>
  </section>
  <div class="status-bar"><span>近期状态</span><strong>写下来的每一个字，都在慢慢变成自己的路</strong><a href="#articles" aria-label="查看最新文章">→</a></div>
  <section class="dashboard-hero" aria-label="博客首页">
    <article class="quote-card" aria-roledescription="carousel" aria-label="林栖谷随笔">
      <div class="quote-controls" role="tablist" aria-label="切换随笔">
        <button class="quote-control is-active" id="quote-tab-1" type="button" role="tab" aria-selected="true" aria-controls="quote-slide-1" aria-label="显示第一则随笔"><span></span></button>
        <button class="quote-control" id="quote-tab-2" type="button" role="tab" aria-selected="false" aria-controls="quote-slide-2" aria-label="显示第二则随笔" tabindex="-1"><span></span></button>
      </div>
      <div class="quote-slides" aria-live="polite">
        <section class="quote-slide is-active" id="quote-slide-1" role="tabpanel" aria-labelledby="quote-tab-1">
          <p class="eyebrow">PERSONAL NOTES</p>
          <h1 class="quote-text">念念不忘，<br />必有回响。</h1>
          <p class="quote-site">LINQIGU NOTES</p>
        </section>
        <section class="quote-slide quote-slide--long" id="quote-slide-2" role="tabpanel" aria-labelledby="quote-tab-2" aria-hidden="true" inert>
          <p class="eyebrow">PERSONAL NOTES</p>
          <h1 class="quote-text">身如柳絮随风扬，<br />无论云泥意贯一。</h1>
          <p class="quote-site">LINQIGU NOTES</p>
        </section>
      </div>
      <span class="quote-mark" aria-hidden="true">“</span>
    </article>
    <% if (featured) { %>
      <a class="photo-card" href="<%- url_for(featured.path) %>" aria-label="阅读最新文章"><img src="<%- url_for('/images/header-landscape.png') %>" alt="晴天下的草坡与画画的人" /><div class="photo-shade"></div><div class="photo-copy"><span>最新文章 · <%= featured.categories.length ? featured.categories.first().name : '随笔' %></span><h2><%= featured.title %></h2></div><span class="recommend">↗ 阅读全文</span></a>
    <% } %>
  </section>
  <section class="content-layout" id="articles">
    <aside class="sidebar">
      <div class="sidebar-card profile-card">
        <div class="profile-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" /></div>
        <div class="profile-identity"><p class="mini-heading">ABOUT THE AUTHOR</p><h2>sunny</h2><i></i><span>INFJ</span><p>一个在互联网行业工作、下班后写字的人。相信好奇心、长期主义，还有一杯热茶。</p></div>
        <div class="profile-socials" aria-label="联系 sunny">
          <a href="https://github.com/sunny-0501" target="_blank" rel="noreferrer" aria-label="GitHub"><span aria-hidden="true">&lt;/&gt;</span></a>
          <a href="mailto:hello@example.com" aria-label="发送邮件"><span aria-hidden="true">✉</span></a>
          <a href="<%- url_for('/rss/') %>" aria-label="RSS 订阅"><span aria-hidden="true">◉</span></a>
        </div>
        <a class="profile-more" href="<%- url_for('/about/') %>">认识我更多 <span>↗</span></a>
      </div>
      <div class="sidebar-card announcement-card" id="announcementCard"><button type="button" id="announcementClose" aria-label="关闭公告">×</button><p class="mini-heading">公告</p><h2>欢迎来到 sunny blog</h2><p>把日常、阅读和正在做的事，慢慢写下来。</p><a class="side-link" href="<%- url_for('/explore/') %>">了解更多 ↗</a></div>
      <div class="sidebar-card topics-card"><p class="mini-heading">按主题浏览</p><a class="topic-link" href="<%- url_for('/categories/项目/') %>">项目与实践 <span><%= site.categories.find({ name: '项目' }).length %></span></a><a class="topic-link" href="<%- url_for('/categories/阅读/') %>">阅读与思考 <span><%= site.categories.find({ name: '阅读' }).length %></span></a><a class="topic-link" href="<%- url_for('/categories/随笔/') %>">随笔与日常 <span><%= site.categories.find({ name: '随笔' }).length %></span></a></div>
    </aside>
    <div class="articles-column">
      <nav class="content-tabs" aria-label="文章视图"><a class="selected" href="<%- url_for('/') %>"><span>首页</span><b><%= posts.length %></b></a><a href="<%- url_for('/categories/项目/') %>"><span>项目</span><b><%= site.categories.find({ name: '项目' }).length %></b></a><a href="<%- url_for('/categories/随笔/') %>"><span>随笔</span><b><%= site.categories.find({ name: '随笔' }).length %></b></a><a href="<%- url_for('/categories/阅读/') %>"><span>阅读</span><b><%= site.categories.find({ name: '阅读' }).length %></b></a><a class="more-tab" href="<%- url_for('/archives/') %>"><span>更多</span><b>→</b></a></nav>
      <div class="section-heading"><div class="section-label"><span>02</span><span>最新文章</span><span class="line"></span></div><div class="filters" role="group" aria-label="文章分类"><button class="filter-button active" type="button" data-filter="all">全部 <b><%= posts.length %></b></button><button class="filter-button" type="button" data-filter="项目">项目 <b><%= site.categories.find({ name: '项目' }).length %></b></button><button class="filter-button" type="button" data-filter="阅读">阅读 <b><%= site.categories.find({ name: '阅读' }).length %></b></button><button class="filter-button" type="button" data-filter="随笔">随笔 <b><%= site.categories.find({ name: '随笔' }).length %></b></button></div></div>
      <div class="article-list" id="articleList"><%- partial('_partial/article-row', { posts: posts.slice(0, 6) }) %></div>
      <p class="empty-state" id="emptyState" hidden>没有找到匹配的文章。</p>
    </div>
  </section>
  <section class="newsletter" id="newsletter"><div><p class="eyebrow">A SMALL LETTER, SOMETIMES</p><h2>偶尔寄一封信给你。</h2><p>目前博客使用静态生成；欢迎通过邮件交流最近读到、想到和正在做的事。</p></div><a class="read-link newsletter-link" href="mailto:hello@example.com">给我写信 <span>↗</span></a></section>
</main>
<%- partial('_partial/document-end') %>
