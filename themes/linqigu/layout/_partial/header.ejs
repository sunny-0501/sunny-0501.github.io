<%
  const activePath = page.path || '';
  const isArticleSection = activePath.startsWith('archives') || activePath.startsWith('categories') || activePath.startsWith('tags') || is_post();
  const isMySection = ['explore', 'gallery', 'rss', 'about'].some((path) => activePath.startsWith(path));
  const navigation = [
    { label: '&#x4E3B;&#x9875;', path: '/', active: is_home(), current: is_home() },
    {
      label: '&#x627E;&#x6587;&#x7AE0;', path: '/archives/', active: isArticleSection, current: activePath.startsWith('archives'),
      menuId: 'articlesMenu', toggleLabel: '&#x5C55;&#x5F00;&#x6587;&#x7AE0;&#x5206;&#x7C7B;',
      menu: [
        { label: '&#x5F52;&#x6863;', path: '/archives/', current: activePath.startsWith('archives'), authorOnly: true },
        { label: '&#x5206;&#x7C7B;', path: '/categories/', current: activePath.startsWith('categories') },
        { label: '&#x6807;&#x7B7E;', path: '/tags/', current: activePath.startsWith('tags') }
      ]
    },
    { label: '友链港湾', path: '/links/', active: activePath.startsWith('links') || activePath.startsWith('guestbook'), current: activePath.startsWith('links') },
    {
      label: '&#x6211;&#x7684;', path: '/explore/', active: isMySection, current: activePath.startsWith('explore'),
      menuId: 'myMenu', toggleLabel: '&#x5C55;&#x5F00;&#x4E2A;&#x4EBA;&#x5206;&#x7C7B;',
      menu: [
        { label: '&#x76F8;&#x518C;', path: '/gallery/', current: activePath.startsWith('gallery') },
        { label: '&#x8BA2;&#x9605;', path: '/rss/', current: activePath.startsWith('rss') }
      ]
    }
  ];
%>
<header class="site-header">
  <a class="brand" href="<%- url_for('/') %>" aria-label="&#x56DE;&#x5230;&#x9996;&#x9875;">
    <img class="brand-logo" src="<%- url_for('/images/ghibli-houseboat-logo.svg') %>" alt="" width="42" height="42" />
    <span class="brand-wordmark">吉卜力画舫<span class="brand-caption">GHIBLI HOUSEBOAT · 个人手记</span></span>
  </a>
  <nav class="main-nav" aria-label="&#x4E3B;&#x5BFC;&#x822A;">
    <% navigation.forEach((item) => { %>
      <% if (item.menu) { %>
        <div class="nav-dropdown <%= item.active ? 'is-active' : '' %>">
          <div class="nav-dropdown__bar">
            <a class="nav-dropdown__link <%= item.active ? 'active' : '' %>" href="<%- url_for(item.path) %>"<%- item.current ? ' aria-current="page"' : '' %><%- item.menuId === 'articlesMenu' ? ' data-archive-section' : '' %>><%- item.label %></a>
            <button class="nav-dropdown__toggle" type="button" aria-label="<%- item.toggleLabel %>" aria-controls="<%= item.menuId %>" aria-expanded="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          </div>
          <div class="nav-dropdown__menu" id="<%= item.menuId %>" hidden>
            <% item.menu.forEach((menuItem) => { %>
              <a class="nav-dropdown__item <%= menuItem.current ? 'active' : '' %>" href="<%- url_for(menuItem.path) %>"<%- menuItem.current ? ' aria-current="page"' : '' %><%- menuItem.authorOnly ? ' data-author-only hidden' : item.menuId === 'articlesMenu' ? ' data-archive-link' : '' %>><%- menuItem.label %></a>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <a class="<%= item.active ? 'active' : '' %>" href="<%- url_for(item.path) %>"<%- item.current ? ' aria-current="page"' : '' %>><%- item.label %></a>
      <% } %>
    <% }); %>
  </nav>
  <div class="header-actions">
    <a class="github-link" href="https://github.com/sunny-0501" target="_blank" rel="noreferrer">GitHub <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
    <button class="search-box" id="searchTrigger" type="button" aria-label="&#x6309;&#x6807;&#x9898;&#x6216;&#x6B63;&#x6587;&#x641C;&#x7D22;&#x6587;&#x7AE0;" aria-haspopup="dialog">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <span class="search-box__placeholder">&#x641C;&#x627E;&#x6587;&#x7AE0;</span>
    </button>
    <a class="header-voyage" href="<%- url_for('/links/#voyage') %>" title="随机访问一个博客"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 6 12H6L12 3Zm0 0v14M3 17h18l-4 4H7l-4-4Z"/></svg><span>随风漫游</span></a>
    <div class="appearance-control">
      <button class="icon-button" id="appearanceToggle" type="button" aria-label="外观设置" aria-controls="appearancePanel" aria-expanded="false">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-1.3-1.1-2-2.3-2h-1.1a2 2 0 0 1-2-2V7A4 4 0 0 0 12 3Z"/><circle cx="7.2" cy="10" r=".7"/><circle cx="10" cy="6.8" r=".7"/><circle cx="14.2" cy="6.8" r=".7"/></svg>
      </button>
      <div class="appearance-panel" id="appearancePanel" hidden>
        <p class="mini-heading">MAKE YOURSELF AT HOME</p>
        <h2>阅读偏好</h2>
        <div class="appearance-group">
          <div class="appearance-heading"><label for="themeHue">主题色相</label><output id="themeHueValue" for="themeHue">148</output></div>
          <input class="theme-hue-slider" id="themeHue" type="range" min="0" max="360" value="148" />
        </div>
        <div class="appearance-group">
          <div class="appearance-heading"><label for="accentHue">强调色相</label><output id="accentHueValue" for="accentHue">43</output></div>
          <input class="accent-hue-slider" id="accentHue" type="range" min="0" max="360" value="43" />
        </div>
        <div class="appearance-group">
          <div class="appearance-heading"><label for="windIntensity">动效强度</label><output id="windIntensityValue" for="windIntensity">60%</output></div>
          <input class="effect-intensity-slider" id="windIntensity" type="range" min="0" max="100" step="10" value="60" aria-describedby="windIntensityScale" />
          <div class="range-endpoints" id="windIntensityScale"><span>关闭</span><span>轻柔</span><span>明显</span></div>
        </div>
      </div>
    </div>
    <div class="theme-control">
      <button class="icon-button" id="themeToggle" type="button" aria-label="选择颜色主题" title="选择颜色主题" aria-controls="themePanel" aria-expanded="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
      <div class="theme-panel" id="themePanel" role="group" aria-label="颜色主题" hidden>
        <button class="theme-option" type="button" data-theme-mode="light" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span>亮色</span></button>
        <button class="theme-option" type="button" data-theme-mode="dark" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg><span>暗色</span></button>
        <button class="theme-option" type="button" data-theme-mode="system" aria-pressed="false"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg><span>跟随系统</span></button>
      </div>
    </div>
  </div>
</header>
