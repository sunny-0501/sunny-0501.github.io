<%
  const activePath = page.path || '';
  const navigation = [
    { label: '&#x4E3B;&#x9875;', path: '/', active: is_home() },
    { label: '&#x6587;&#x7AE0;', path: '/archives/', active: activePath.startsWith('archives') || activePath.startsWith('categories') || activePath.startsWith('tags') || is_post() },
    { label: '&#x53CB;&#x94FE;', path: '/links/', active: activePath.startsWith('links') },
    { label: '&#x7559;&#x8A00;', path: '/guestbook/', active: activePath.startsWith('guestbook') },
    { label: '&#x6211;&#x7684;', path: '/explore/', active: ['explore', 'gallery', 'rss'].some((path) => activePath.startsWith(path)) },
    { label: '&#x5173;&#x4E8E;', path: '/about/', active: activePath.startsWith('about') }
  ];
%>
<header class="site-header">
  <a class="brand" href="<%- url_for('/') %>" aria-label="&#x56DE;&#x5230;&#x9996;&#x9875;">
    <img class="brand-logo" src="<%- url_for('/images/avatar.png') %>" alt="" width="42" height="42" />
    <span class="brand-wordmark">sunny's blog<span class="brand-caption">林栖谷 · 个人手记</span></span>
  </a>
  <nav class="main-nav" aria-label="&#x4E3B;&#x5BFC;&#x822A;">
    <% navigation.forEach((item) => { %>
      <a class="<%= item.active ? 'active' : '' %>" href="<%- url_for(item.path) %>"<%- item.active ? ' aria-current="page"' : '' %>><%- item.label %></a>
    <% }); %>
  </nav>
  <div class="header-actions">
    <a class="github-link" href="https://github.com/sunny-0501" target="_blank" rel="noreferrer">GitHub <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
    <button class="search-box" id="searchTrigger" type="button" aria-label="&#x641C;&#x7D22;&#x6587;&#x7AE0;" aria-haspopup="dialog">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <span class="search-box__placeholder">&#x641C;&#x7D22;&#x6587;&#x7AE0;</span>
    </button>
    <div class="appearance-control">
      <button class="icon-button" id="appearanceToggle" type="button" aria-label="外观设置" aria-controls="appearancePanel" aria-expanded="false">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-1.3-1.1-2-2.3-2h-1.1a2 2 0 0 1-2-2V7A4 4 0 0 0 12 3Z"/><circle cx="7.2" cy="10" r=".7"/><circle cx="10" cy="6.8" r=".7"/><circle cx="14.2" cy="6.8" r=".7"/></svg>
      </button>
      <div class="appearance-panel" id="appearancePanel" hidden>
        <p class="mini-heading">MAKE YOURSELF AT HOME</p>
        <h2>阅读偏好</h2>
        <div class="appearance-group">
          <div class="appearance-heading"><label for="themeHue">主题色相</label><output id="themeHueValue" for="themeHue">165</output></div>
          <input class="theme-hue-slider" id="themeHue" type="range" min="0" max="360" value="165" />
        </div>
        <div class="appearance-group">
          <div class="appearance-heading"><label for="windIntensity">动效强度</label><output id="windIntensityValue" for="windIntensity">60%</output></div>
          <input class="effect-intensity-slider" id="windIntensity" type="range" min="0" max="100" step="10" value="60" aria-describedby="windIntensityScale" />
          <div class="range-endpoints" id="windIntensityScale"><span>关闭</span><span>轻柔</span><span>明显</span></div>
        </div>
        <div class="appearance-group">
          <span>文章布局</span>
          <div class="layout-options" role="group" aria-label="文章布局"><button type="button" data-layout-mode="list"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg>列表</button><button type="button" data-layout-mode="grid"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>网格</button></div>
        </div>
      </div>
    </div>
    <button class="icon-button" id="themeToggle" type="button" aria-label="切换为深色主题" title="切换为深色主题" aria-pressed="false"><svg class="ui-icon theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg><svg class="ui-icon theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </div>
</header>
