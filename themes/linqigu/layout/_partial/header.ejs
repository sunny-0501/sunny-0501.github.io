<% const activePath = page.path || ''; %>
<header class="site-header">
  <a class="brand" href="<%- url_for('/') %>" aria-label="&#x56DE;&#x5230;&#x9996;&#x9875;">
    <img class="brand-logo" src="<%- url_for('/images/linqigu-logo.svg') %>" alt="&#x6797;&#x6816;&#x8C37;" />
  </a>
  <span class="totoro-track" role="img" aria-label="&#x5728;&#x9876;&#x680F;&#x6563;&#x6B65;&#x7684;&#x9F99;&#x732B;">
    <span class="totoro-walker">
      <svg class="totoro-svg" viewBox="0 0 110 86" aria-hidden="true">
        <path class="totoro-tail" d="M87 62C103 63 106 50 99 45" fill="none" stroke="#65716e" stroke-width="8" stroke-linecap="round" />
        <ellipse class="totoro-body" cx="55" cy="56" rx="33" ry="25" fill="#65716e" />
        <ellipse cx="57" cy="62" rx="23" ry="16" fill="#e9e4d5" />
        <path d="M45 57L50 62L45 66M58 56L63 61L58 66M70 56L75 61L70 65" fill="none" stroke="#65716e" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="totoro-head" d="M25 48C23 34 27 18 39 10L49 23C55 20 63 20 70 23L81 10C89 21 92 36 87 49C83 60 70 65 56 65C41 65 29 59 25 48Z" fill="#65716e" />
        <path d="M30 29L39 10L48 29M72 28L81 10L86 35" fill="#8f9b96" stroke="#4a5552" stroke-width="1.4" stroke-linejoin="round" />
        <g class="totoro-face">
          <ellipse cx="44" cy="39" rx="5" ry="7" fill="#fffdf7" />
          <ellipse cx="69" cy="39" rx="5" ry="7" fill="#fffdf7" />
          <circle class="totoro-eye" cx="45" cy="41" r="2.4" fill="#263a35" />
          <circle class="totoro-eye" cx="70" cy="41" r="2.4" fill="#263a35" />
          <path d="M55 48L61 48L58 52Z" fill="#2b3935" />
          <path d="M58 52C55 56 50 55 48 53M58 52C61 56 66 55 68 53" fill="none" stroke="#263a35" stroke-width="1.5" stroke-linecap="round" />
          <path d="M35 49L17 46M35 54L17 55M82 49L100 46M82 54L100 55" fill="none" stroke="#263a35" stroke-width="1.1" stroke-linecap="round" opacity=".72" />
        </g>
        <path class="totoro-arm totoro-arm-left" d="M32 59C22 63 21 68 26 71" fill="none" stroke="#65716e" stroke-width="7" stroke-linecap="round" />
        <path class="totoro-arm totoro-arm-right" d="M81 59C91 62 93 67 88 71" fill="none" stroke="#65716e" stroke-width="7" stroke-linecap="round" />
        <path class="totoro-foot totoro-foot-left" d="M39 76L50 76" stroke="#4a5552" stroke-width="7" stroke-linecap="round" />
        <path class="totoro-foot totoro-foot-right" d="M64 76L75 76" stroke="#4a5552" stroke-width="7" stroke-linecap="round" />
      </svg>
    </span>
  </span>
  <nav class="main-nav" aria-label="&#x4E3B;&#x5BFC;&#x822A;">
    <a class="<%= activePath === '' ? 'active' : '' %>" href="<%- url_for('/') %>">&#x9996;&#x9875;</a>
    <a class="<%= activePath.startsWith('archives') || activePath.startsWith('categories') || activePath.startsWith('tags') || is_post() ? 'active' : '' %>" href="<%- url_for('/archives/') %>">&#x6587;&#x7AE0;</a>
    <a class="<%= activePath.startsWith('about') ? 'active' : '' %>" href="<%- url_for('/about/') %>">&#x5173;&#x4E8E;</a>
    <a class="<%= activePath.startsWith('links') ? 'active' : '' %>" href="<%- url_for('/links/') %>">&#x53CB;&#x94FE;</a>
  </nav>
  <div class="header-actions">
    <label class="search-box" aria-label="&#x641C;&#x7D22;&#x6587;&#x7AE0;"><span aria-hidden="true">&#x2315;</span><input id="searchInput" type="search" placeholder="&#x641C;&#x7D22;&#x6587;&#x7AE0;" /></label>
    <button class="icon-button" id="themeToggle" type="button" aria-label="&#x5207;&#x6362;&#x989C;&#x8272;&#x4E3B;&#x9898;" title="&#x5207;&#x6362;&#x989C;&#x8272;&#x4E3B;&#x9898;">&#x2600;</button>
  </div>
</header>
