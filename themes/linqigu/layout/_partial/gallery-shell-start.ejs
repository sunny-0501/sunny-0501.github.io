<%
  const galleryShellTitle = typeof title === 'string' ? title : '相册';
  const galleryShellDescription = typeof description === 'string' ? description : '记录生活中的美好瞬间';
  const albumView = typeof isAlbum !== 'undefined' && isAlbum;
  const galleryAlbums = (site.data.gallery && site.data.gallery.albums) || [];
  const publicPostCount = site.posts.toArray().filter((post) => post.archived !== true).length;
%>
<main class="inner-page gallery-page" id="top">
  <section class="gallery-hero" aria-labelledby="galleryHeroTitle">
    <div class="gallery-hero__content">
      <p class="eyebrow"><%= albumView ? 'MOMENTS IN THE JOURNAL' : 'A LITTLE COLLECTION OF LIFE' %></p>
      <h1 id="galleryHeroTitle"><%= galleryShellTitle %></h1>
      <p><%= galleryShellDescription %></p>
    </div>
  </section>
  <div class="gallery-dashboard">
    <aside class="gallery-author" aria-label="关于作者">
      <section class="gallery-side-card profile-card gallery-profile-card">
        <div class="profile-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" loading="lazy" /></div>
        <div class="profile-identity"><p class="mini-heading">ABOUT THE AUTHOR</p><h2>sunny</h2><i></i><span>INFJ · 林栖谷</span><p>一个在互联网行业工作、下班后写字的人。相信好奇心、长期主义，还有一杯热茶。</p></div>
        <a class="gallery-profile-link" href="<%- url_for('/explore/') %>">认识我更多 <span aria-hidden="true">↗</span></a>
      </section>
      <section class="gallery-side-card gallery-side-note"><p class="mini-heading">SLOW DOWN &amp; LOOK AROUND</p><p>让目光停留片刻，<br />总有一些美好值得收藏。</p></section>
    </aside>
    <div class="gallery-main">
      <nav class="gallery-breadcrumb" aria-label="相册导航">
        <a class="gallery-home-link" href="<%- url_for('/') %>" aria-label="首页"><svg class="ui-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 3 9 8h-2v10h-5v-7h-4v7H5V11H3Z"/></svg></a>
        <% if (!albumView) { %><a href="<%- url_for('/archives/') %>">文章 <b><%= publicPostCount %></b></a><% } %>
        <a href="<%- url_for('/gallery/') %>"<%- albumView ? '' : ' aria-current="page"' %>>相册 <b><%= galleryAlbums.length %></b></a>
        <% if (albumView) { %><span class="gallery-breadcrumb-current" aria-current="page"><%= galleryShellTitle %></span><% } %>
        <a class="gallery-more-link" href="<%- url_for('/explore/') %>">更多 <span aria-hidden="true">›</span></a>
      </nav>
