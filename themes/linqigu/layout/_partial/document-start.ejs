<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= page.description || config.description %>" />
    <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
    <link rel="icon" href="<%- url_for('/images/ghibli-houseboat-logo.svg') %>" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Noto+Serif+SC:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%- url_for('/css/styles.css') %>?v=article-toolbar-v2" />
    <link rel="stylesheet" href="<%- url_for('/css/hexo.css') %>" /><% if (typeof archiveView !== 'undefined' && archiveView) { %>
    <link rel="stylesheet" href="<%- url_for('/css/archive.css') %>?v=archive-shell-v2" /><% } %>
    <% if (typeof exploreView !== 'undefined' && exploreView) { %><link rel="stylesheet" href="<%- url_for('/css/explore.css') %>?v=my-space-v1" /><link rel="stylesheet" href="<%- url_for('/css/explore-portals.css') %>?v=forest-portals-v1" /><% } %>
    <% if (typeof galleryView !== 'undefined' && galleryView) { %><link rel="stylesheet" href="<%- url_for('/css/gallery.css') %>?v=gallery-backdrop-v1" /><% } %>
    <% if (typeof isAlbum !== 'undefined' && isAlbum) { %><link rel="stylesheet" href="<%- url_for('/css/gallery-album.css') %>?v=gallery-album-v1" /><% } %>
    <link rel="stylesheet" href="<%- url_for('/css/houseboat.css') %>?v=houseboat-japanese-breeze-v2" />
    <link rel="alternate" type="application/atom+xml" title="吉卜力画舫" href="<%- url_for('/atom.xml') %>" />
  </head>
  <body class="<%= is_home() ? 'home-page' : typeof archiveView !== 'undefined' && archiveView ? 'archive-view' : typeof galleryView !== 'undefined' && galleryView ? 'gallery-view' : typeof exploreView !== 'undefined' && exploreView ? 'explore-view' : '' %>">
    <a class="skip-link" href="#top">跳到正文</a>
    <script>try { const savedMode = localStorage.getItem('blog-theme-mode'); const legacyMode = localStorage.getItem('blog-theme'); const mode = ['light', 'dark', 'system'].includes(savedMode) ? savedMode : ['light', 'dark'].includes(legacyMode) ? legacyMode : 'system'; if (mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) document.body.classList.add('dark'); } catch {}</script>
    <% if (is_post()) { %>
      <div class="reading-progress" aria-hidden="true"><span id="readingProgressBar"></span></div>
    <% } %>
    <div class="wind-layer" id="windLayer" aria-hidden="true"></div>
    <dialog class="search-dialog" id="siteSearchDialog" aria-labelledby="siteSearchTitle" data-search-url="<%- url_for('/search.xml') %>">
      <div class="search-dialog__panel">
        <header class="search-dialog__header">
          <div>
            <p class="eyebrow">SEARCH THE JOURNAL</p>
            <h2 id="siteSearchTitle">搜索吉卜力画舫</h2>
          </div>
          <button class="search-dialog__close" type="button" data-search-close aria-label="关闭搜索">×</button>
        </header>
        <label class="search-command">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
          <input id="siteSearchInput" type="search" aria-label="搜索文章" aria-describedby="siteSearchStatus" placeholder="按标题或正文关键词搜索…" autocomplete="off" spellcheck="false" />
          <kbd>ESC</kbd>
        </label>
        <div class="search-feedback"><p class="search-dialog__status" id="siteSearchStatus" role="status" aria-live="polite">输入关键词，可按标题或正文搜索全部文章。</p><button class="search-retry" id="searchRetry" type="button" hidden>重新加载</button></div>
        <div class="search-results" id="siteSearchResults"></div>
        <footer class="search-dialog__footer"><span>搜索全部文章</span><span>Ctrl / ⌘ + K 快速打开</span></footer>
      </div>
    </dialog>
    <dialog class="lightbox" id="lightboxDialog" aria-label="图片预览">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="关闭图片">×</button>
      <figure><img id="lightboxImage" alt="" /><figcaption id="lightboxCaption"></figcaption></figure>
    </dialog>
    <div class="site-shell">
      <%- partial('_partial/header') %>
