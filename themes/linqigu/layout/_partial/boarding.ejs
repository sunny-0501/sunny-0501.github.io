<dialog class="boarding" id="boardingDialog" aria-labelledby="boardingTitle" aria-describedby="boardingDescription" data-boarding-home="<%= is_home() ? 'true' : 'false' %>">
  <div class="boarding__scene">
    <img class="boarding__landscape" src="<%- url_for('/images/header-landscape.png') %>" alt="" loading="<%= is_home() ? 'eager' : 'lazy' %>" fetchpriority="<%= is_home() ? 'high' : 'low' %>" decoding="async" />
    <div class="boarding__veil" aria-hidden="true"></div>
    <div class="boarding__grain" aria-hidden="true"></div>
    <div class="boarding__leaves" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <header class="boarding__header">
      <span class="boarding__brand"><img src="<%- url_for('/images/ghibli-houseboat-logo.svg') %>" alt="" width="44" height="44" /><span>吉卜力画舫</span></span>
      <button class="boarding__skip" type="button" data-boarding-close>跳过，直接进入 <span aria-hidden="true">↗</span></button>
    </header>
    <div class="boarding__content">
      <div class="boarding__poem">
        <h2 id="boardingTitle">你好，<br />欢迎来坐坐<span>。</span></h2>
        <p id="boardingDescription">这里是 sunny 的博客。<br />写写工作，也记些日常。</p>
      </div>
      <section class="boarding__ticket" aria-label="吉卜力画舫登船券">
        <svg class="boarding__validation" viewBox="0 0 76 76" fill="none" aria-hidden="true"><circle cx="38" cy="38" r="33" stroke="currentColor" stroke-width="1.7"/><circle cx="38" cy="38" r="28" stroke="currentColor" stroke-width=".8" stroke-dasharray="2 3"/><path d="M23 42h30l-6 9H29l-6-9Zm15-22v21m-3-17-9 14h9V24Zm6 4v10h8l-8-10Z" fill="currentColor" fill-opacity=".1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M27 55c4-3 6 3 10 0s6 3 10 0" stroke="currentColor" stroke-linecap="round"/></svg>
        <div class="boarding__ticket-main">
          <svg class="boarding__punch" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="#496d56"/><circle cx="12" cy="12" r="8" fill="none" stroke="#345641" stroke-opacity=".24"/></svg>
          <div class="boarding__ticket-top"><span>登船券</span><small>吉卜力画舫</small></div>
          <div class="boarding__route"><span><small>船主</small><strong>sunny</strong></span><svg viewBox="0 0 90 24" fill="none" aria-hidden="true"><path d="M1 12h84m-9-8 9 8-9 8" stroke="currentColor" stroke-width="1.2"/><circle cx="20" cy="12" r="3" fill="currentColor"/></svg><span><small>去往</small><strong>博客首页</strong></span></div>
        </div>
        <div class="boarding__ticket-stub">
          <button class="boarding__enter" type="button" data-boarding-close autofocus><span>登上画舫</span><svg class="boarding__button-boat" viewBox="0 0 30 24" fill="none" aria-hidden="true"><path d="M3 15h24l-5 6H8l-5-6Zm11-2V2m-2 1-7 9h7V3Zm5 2v7h7l-7-7Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path class="boarding__button-wake" d="M1 23h9m4 0h6m4 0h5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg></button>
        </div>
      </section>
    </div>
    <svg class="boarding__paper-plane" viewBox="0 0 150 70" fill="none" aria-hidden="true"><path class="boarding__plane-trail" d="M2 59c39 13 61-3 61-17S39 26 43 41s36 11 57-14" stroke="currentColor" stroke-opacity=".5" stroke-width="1" stroke-dasharray="3 4"/><g class="boarding__plane"><path d="m99 24 32-15-9 29-8-12-15-2Z" fill="#fff9e6" fill-opacity=".85" stroke="currentColor" stroke-linejoin="round"/><path d="m114 26 17-17-21 26 4-9Z" fill="#b9c8ab" stroke="currentColor" stroke-linejoin="round"/></g></svg>
  </div>
</dialog>
