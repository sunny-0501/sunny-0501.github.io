<%
  const galleryStatsPosts = site.posts.toArray().filter((post) => post.archived !== true);
  const galleryStatsCategories = new Set(galleryStatsPosts.flatMap((post) => post.categories.toArray().map((category) => category.name))).size;
  const galleryStatsTags = new Set(galleryStatsPosts.flatMap((post) => post.tags.toArray().map((tag) => tag.name))).size;
  const galleryStatsWords = galleryStatsPosts.reduce((sum, post) => sum + (post.content || '').replace(/<[^>]*>/g, ' ').replace(/&[^;]+;/g, ' ').replace(/\s+/g, '').length, 0);
  const galleryStatsAlbums = (site.data.gallery && site.data.gallery.albums) || [];
  const galleryStatsPhotos = galleryStatsAlbums.reduce((sum, album) => sum + (album.photos || []).length, 0);
%>
    </div>
    <aside class="gallery-sidebar" aria-label="站点信息">
      <section class="gallery-side-card gallery-stat-card" aria-labelledby="galleryStatsTitle">
        <h2 class="gallery-card-title" id="galleryStatsTitle">站点统计</h2>
        <dl class="gallery-stat-list">
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>文章</dt><dd><%= galleryStatsPosts.length %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h6l2 2h10v11H3Z"/></svg>分类</dt><dd><%= galleryStatsCategories %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h9l9 9-8 8-10-10Z"/><circle cx="7.5" cy="8.5" r="1"/></svg>标签</dt><dd><%= galleryStatsTags %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>总字数</dt><dd><%= galleryStatsWords.toLocaleString('zh-CN') %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="17" height="16" rx="2"/><path d="m7 15 3-4 3 4 3-3 2 3"/></svg>相册</dt><dd><%= galleryStatsAlbums.length %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 6-6 5 5 3-3 4 4"/></svg>照片</dt><dd><%= galleryStatsPhotos %></dd></div>
        </dl>
      </section>
      <section class="gallery-side-card gallery-background-note"><p class="mini-heading">IN THE PICTURE</p><p>山坡、绿树与晴空，<br />收藏一整个明亮的夏天。</p><a href="https://www.ghibli.jp/works/kokurikozaka/" target="_blank" rel="noopener noreferrer">背景出自《虞美人盛开的山坡》 ↗</a></section>
    </aside>
  </div>
</main>
