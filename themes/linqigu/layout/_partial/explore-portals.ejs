<section class="explore-portals" aria-labelledby="explorePortalsTitle">
  <header class="explore-portals-heading">
    <div><h2 id="explorePortalsTitle">相册与订阅</h2></div>
  </header>
  <div class="explore-portals-grid">
    <a class="explore-portal explore-portal--gallery" href="<%- url_for('/gallery/') %>" aria-label="打开相册" data-photo-stack>
      <div class="portal-art portal-art--gallery" aria-hidden="true">
        <span class="portal-ticket">01 <i></i> FOREST CINEMA</span>
        <svg class="portal-landscape" viewBox="0 0 600 280" preserveAspectRatio="xMidYMid slice" focusable="false">
          <path class="portal-sky" d="M0 0h600v280H0z"/>
          <circle class="portal-sun" cx="464" cy="67" r="33"/>
          <path class="portal-cloud" d="M348 71c-3-12 6-21 17-20 2-13 23-16 29-1 12-5 22 7 17 17h-63ZM78 113c-4-10 5-19 15-16 4-15 27-16 31 0 12-5 23 4 22 16Z"/>
          <path class="portal-hill-far" d="M-20 203Q75 114 185 171T388 164t231 33v85H-20Z"/>
          <path class="portal-hill-near" d="M-20 244q119-84 267-23t371-20v81H-20Z"/>
          <path class="portal-trunk" d="m56 0 13 1 3 215-11 17Zm456 0h15l-5 233-12-14Z"/>
          <g class="portal-canopy"><ellipse cx="25" cy="29" rx="100" ry="59"/><ellipse cx="91" cy="-2" rx="85" ry="60"/><ellipse cx="557" cy="25" rx="91" ry="66"/><ellipse cx="616" cy="82" rx="73" ry="72"/></g>
          <g class="portal-canopy-light"><ellipse cx="14" cy="84" rx="56" ry="48"/><ellipse cx="103" cy="22" rx="50" ry="30"/><ellipse cx="556" cy="12" rx="47" ry="27"/></g>
          <g class="portal-fern" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M28 281q25-69 81-87M49 240l-8-26m16 12 2-27m12 17 10-27m-31 54 28 1m-11-18 29 1m-13-18 28-3M553 280q-4-48-47-79m39 53 22-13m-26 1 20-17m-32 3 15-22m-1 50-26-5m17-13-25-9"/></g>
          <g class="portal-mushroom"><path d="M117 273v-15h9v15Z" fill="#f5e9c9"/><path d="M104 259q16-26 34 0Z" fill="#b67155"/><circle cx="118" cy="252" r="2" fill="#f6e4c5"/><circle cx="128" cy="256" r="2" fill="#f6e4c5"/></g>
        </svg>
        <span class="portal-photo portal-photo--back"><img src="<%- url_for('/images/forest-rest.png') %>" alt="" loading="lazy" /><span>林间休憩</span></span>
        <span class="portal-photo portal-photo--front"><img src="<%- url_for('/images/header-landscape.png') %>" alt="" loading="lazy" /><span>晴日的草坡</span></span>
        <svg class="portal-gallery-leaf" viewBox="0 0 64 64" fill="none" focusable="false"><path d="M53 10C19 6 7 28 15 44 33 55 54 41 53 10Z" fill="currentColor"/><path d="m12 53 31-31m-17 17-3-13m10 6 12 1" stroke="#dce4b4" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <div class="portal-content">
        <div class="portal-content-heading"><h3>相册</h3><span class="portal-route-label">GALLERY</span></div>
        <p>插画、壁纸和博客素材。</p>
        <span class="portal-invitation">查看相册 <span class="portal-arrow" aria-hidden="true">↗</span></span>
      </div>
    </a>
    <a class="explore-portal explore-portal--rss" href="<%- url_for('/rss/') %>" aria-label="通过 RSS 订阅博客">
      <div class="portal-art portal-art--rss" aria-hidden="true">
        <span class="portal-ticket">02 <i></i> WIND POST OFFICE</span>
        <svg class="portal-postal-scene" viewBox="0 0 600 280" preserveAspectRatio="xMidYMid slice" focusable="false">
          <path class="portal-mail-sky" d="M0 0h600v280H0z"/>
          <circle class="portal-mail-sun" cx="103" cy="89" r="37"/>
          <path class="portal-cloud" d="M395 84c-6-15 5-27 19-23 4-18 29-19 35-1 14-4 26 10 19 24h-73Z"/>
          <path class="portal-mail-hill" d="M-5 241q130-73 288-2t326-32v78H-5Z"/>
          <g class="portal-wind-lines" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M52 158h62q21 0 21-13t-14-13M399 190h58q23 0 23-13t-15-13M440 203h58M75 174h32"/></g>
          <g class="portal-mailbox" transform="translate(464 153)"><path d="M29 49h7v74h-7Z" fill="#826b4d"/><path d="M0 20C0-8 52-8 52 20v39H0Z" fill="#70886b"/><path d="M0 21C0 0 31 0 31 21v38H0Z" fill="#9bae85"/><path d="M9 25h15" fill="none" stroke="#53684c" stroke-width="3" stroke-linecap="round"/><path d="M44 37V6h18v13H47" fill="#bd735b" stroke="#795342" stroke-width="2" stroke-linejoin="round"/></g>
          <g class="portal-envelope-back"><path d="m181 143 111-77 111 77v103H181Z" fill="#b89c69"/><path d="m181 143 111 65 111-65Z" fill="#a68a5a"/></g>
          <g class="portal-letter"><path d="m213 94 163-9 8 136-163 8Z" fill="#fffbed" stroke="#d8cfad" stroke-width="1.5"/><path d="m236 129 83-4m-81 19 115-6m-114 21 100-5m-99 20 64-3" fill="none" stroke="#c6c8a6" stroke-width="3" stroke-linecap="round"/><g transform="translate(333 101) rotate(-3)"><rect width="27" height="27" rx="4" fill="#8fa47d"/><circle cx="7" cy="20" r="2" fill="#fffbed"/><path d="M6 13q8 0 8 8M6 6q15 0 15 15" fill="none" stroke="#fffbed" stroke-width="2"/></g></g>
          <g class="portal-envelope-front"><path d="M181 143v103h222V143L292 211Z" fill="#ddc393"/><path d="m181 246 111-83 111 83Z" fill="#ead1a3"/><path d="m181 143 111 68 111-68M181 246l80-60m142 60-80-60" fill="none" stroke="#c3a574" stroke-width="1.5"/><circle cx="292" cy="202" r="15" fill="#b66f54"/><path d="M285 202q7-12 15-5-2 13-13 11m2-1 8-9" fill="none" stroke="#eec7a1" stroke-width="1.5" stroke-linecap="round"/></g>
          <g class="portal-paper-plane"><path d="m386 58 65-15-24 45-8-21Z" fill="#fffbec" stroke="#b7bda2" stroke-width="1.5" stroke-linejoin="round"/><path d="m419 67 32-24-39 20" fill="none" stroke="#b7bda2" stroke-width="1.5"/><path d="m419 67-5 17 13-12" fill="#e3e8d0"/></g>
          <g class="portal-sprigs" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m74 280 6-53m-3 33-13-12m15-3 13-15m-14 12-12-13m420 52 10-25m-7 15-9-7m11 1 11-3"/></g>
          <g fill="#f7f0cf"><circle cx="64" cy="246" r="4"/><circle cx="94" cy="229" r="4"/><circle cx="66" cy="226" r="4"/></g>
        </svg>
        <span class="portal-postmark"><b>吉卜力画舫</b><span>LETTERS · RSS</span></span>
      </div>
      <div class="portal-content">
        <div class="portal-content-heading"><h3>订阅</h3><span class="portal-route-label">RSS FEED</span></div>
        <p>在 RSS 阅读器里接收更新。</p>
        <span class="portal-invitation">查看订阅地址 <span class="portal-arrow" aria-hidden="true">↗</span></span>
      </div>
    </a>
  </div>
</section>
