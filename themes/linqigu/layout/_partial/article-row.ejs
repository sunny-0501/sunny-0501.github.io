<% const thumbMap = { '项目': 'thumb-tool', '阅读': 'thumb-book', '随笔': 'thumb-walk' }; const coverMap = { '项目': '/images/explore-moving-castle.jpg', '阅读': '/images/links-cottage.jpg', '随笔': '/images/forest-rest.png' }; %>
<% posts.filter((post) => post.archived !== true).forEach(function(post) { %>
  <% const category = post.categories && post.categories.length ? post.categories.first().name : '随笔'; %>
  <% const sourcePath = ['source', ...String(post.source || '').replace(/^source\//, '').split('/')].map(encodeURIComponent).join('/'); %>
  <% const summary = (post.excerpt || post.content || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim(); %>
  <% const readingMinutes = Math.max(1, Math.ceil(summary.length / 400)); %>
  <article class="article-row" data-category="<%= category %>">
    <div class="article-thumb <%= thumbMap[category] || 'thumb-tool' %>"><img src="<%- url_for(post.cover || coverMap[category] || '/images/header-landscape.png') %>" alt="" loading="lazy" width="320" height="220" /><span><%= category %> / JOURNAL</span></div>
    <div class="article-body">
      <div class="article-meta"><span class="tag"><%= category %></span><time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span><%= readingMinutes %> MIN</span></div>
      <h3><a class="article-link" href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
      <p><%= summary.length > 100 ? summary.slice(0, 100) + '…' : summary %></p>
    </div>
    <span class="row-actions"><a class="archive-action" data-author-only hidden href="https://github.com/sunny-0501/sunny-0501.github.io/edit/main/<%= sourcePath %>" target="_blank" rel="noopener noreferrer" title="在 GitHub 源文件中添加 archived: true；需要仓库写入权限" aria-label="在 GitHub 编辑文章《<%= post.title %>》并归档">归档</a><span class="row-arrow" aria-hidden="true">↗</span></span>
  </article>
<% }); %>
