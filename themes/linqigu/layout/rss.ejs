<%
  const posts = site.posts.sort('date', -1).toArray().filter((post) => post.archived !== true);
%>
<%- partial('_partial/document-start') %>
<main class="inner-page" id="top">
  <div class="status-bar"><span>订阅</span><strong>RSS / Atom</strong><a href="<%- url_for('/explore/') %>" aria-label="返回我的页面">↗</a></div>
  <section class="page-hero archive-hero"><div><h1>订阅博客</h1><p>把下面的地址添加到 RSS 阅读器，就能收到新文章。</p></div><div class="page-hero-symbol" aria-hidden="true">RSS</div></section>
  <section class="page-content rss-layout">
    <div class="rss-feed-card"><p class="mini-heading">订阅地址</p><code>https://sunny-0501.github.io/atom.xml</code><a class="publish-button" href="<%- url_for('/atom.xml') %>">打开订阅源 ↗</a></div>
    <div class="rss-recent"><p class="mini-heading">最近更新</p><% posts.slice(0, 6).forEach(function (post) { %><a href="<%- url_for(post.path) %>"><time><%= date(post.date, 'YYYY.MM.DD') %></time><strong><%= post.title %></strong><span>↗</span></a><% }); %></div>
  </section>
</main>
<%- partial('_partial/document-end') %>
