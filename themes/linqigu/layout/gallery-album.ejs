<%
  const albums = site.data.gallery.albums;
  const album = albums.find((item) => item.slug === page.album);
  if (!album) throw new Error('Unknown gallery album: ' + page.album);
  const categoryLabels = { wallpaper: '壁纸', illustration: '插画' };
%>
<%- partial('_partial/document-start', { galleryView: true, isAlbum: true }) %>
<%- partial('_partial/gallery-shell-start', { title: album.title, description: album.description, isAlbum: true, album: album }) %>
  <section class="gallery-library gallery-album-library" aria-labelledby="galleryTitle">
    <a class="gallery-back-link" href="<%- url_for('/gallery/') %>"><span aria-hidden="true">←</span> 返回相册</a>
    <header class="gallery-page-heading">
      <span class="gallery-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="17" height="16" rx="2"/><path d="M7 15l3-4 2.2 2.6L15 10l3 5H7Z"/><path d="M7 2h14a2 2 0 0 1 2 2v12"/></svg></span>
      <div><h2 id="galleryTitle"><%= album.title %></h2><p><%= album.description %></p></div>
    </header>
    <label class="gallery-search">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
      <input id="gallerySearch" type="search" aria-label="搜索合集中的图片" placeholder="搜索图片..." autocomplete="off" />
    </label>
    <div class="gallery-filters" role="group" aria-label="图片分类">
      <button class="gallery-filter" type="button" data-gallery-filter="all" aria-pressed="true">全部</button>
      <button class="gallery-filter" type="button" data-gallery-filter="wallpaper" aria-pressed="false">壁纸</button>
      <button class="gallery-filter" type="button" data-gallery-filter="illustration" aria-pressed="false">插画</button>
    </div>
    <div class="gallery-display-toolbar">
      <p class="gallery-photo-count" id="galleryPhotoCount" role="status" aria-live="polite">共 <%= album.photos.length %> 张照片</p>
      <div class="gallery-play-tools" data-gallery-play-tools hidden><button type="button" data-gallery-develop aria-controls="galleryGrid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 5h16v14H4zM8 3v4m8-4v4M7 16l4-5 3 3 2-2 3 4" stroke-linecap="round" stroke-linejoin="round"/></svg>重新显影</button><button type="button" data-gallery-shuffle aria-controls="galleryGrid"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h4l10 12h4M17 15l4 3-4 3M3 18h4L17 6h4M17 3l4 3-4 3" stroke-linecap="round" stroke-linejoin="round"/></svg>打乱顺序</button></div>
      <div class="gallery-view-options" role="group" aria-label="图片排列方式">
        <button type="button" data-gallery-view="grid" aria-pressed="true" aria-controls="galleryGrid"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span>网格</span></button>
        <button type="button" data-gallery-view="list" aria-pressed="false" aria-controls="galleryGrid"><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M9 5h12M9 12h12M9 19h12"/><rect x="3" y="3" width="2" height="4" rx=".5"/><rect x="3" y="10" width="2" height="4" rx=".5"/><rect x="3" y="17" width="2" height="4" rx=".5"/></svg><span>列表</span></button>
      </div>
    </div>
    <div class="gallery-grid gallery-photo-grid" id="galleryGrid" data-gallery-layout="grid">
      <% album.photos.forEach(function (photo) { %>
        <figure class="gallery-card gallery-photo-card<%= photo.soft ? ' gallery-card-soft' : '' %>" data-gallery-photo data-gallery-category="<%= photo.categories.join(' ') %>" data-gallery-search="<%= photo.search %>">
          <button class="gallery-item gallery-photo-button" type="button" data-lightbox-src="<%- url_for(photo.src) %>" data-lightbox-caption="<%= photo.title %>" aria-label="预览：<%= photo.title %>">
            <span class="gallery-photo-image"><img src="<%- url_for(photo.src) %>" alt="<%= photo.alt %>" loading="lazy" /></span>
            <span class="gallery-photo-copy"><strong><%= photo.title %></strong><span class="gallery-photo-tags"><%= photo.categories.map((category) => categoryLabels[category] || category).join(' · ') %></span></span>
            <span class="gallery-photo-open" aria-hidden="true">↗</span>
          </button>
        </figure>
      <% }); %>
    </div>
    <p class="gallery-play-status" data-gallery-play-status role="status" aria-live="polite" hidden></p>
    <p class="gallery-empty" id="galleryEmpty" role="status" hidden>没有找到符合条件的图片，试试其他关键词或分类。</p>
  </section>
<%- partial('_partial/gallery-shell-end') %>
<%- partial('_partial/document-end') %>
