<%- partial('_partial/document-start', { exploreView: true }) %>
<main class="inner-page explore-page" id="top">
  <section class="explore-hero" aria-labelledby="exploreHeroTitle">
    <div class="explore-hero__content">
      <h1 id="exploreHeroTitle">我的</h1>
      <p>关于我和这个博客。</p>
    </div>
  </section>
  <section class="explore-content" aria-label="作者介绍与个人收藏">
    <section class="explore-introduction" aria-labelledby="exploreAuthorTitle">
      <div class="explore-author-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" width="152" height="152" /></div>
      <div class="explore-author-copy">
        <h2 id="exploreAuthorTitle">你好，我是 sunny。</h2>
        <p>在互联网行业工作。这里写项目、读书笔记，还有一些日常。</p>
      </div>
    </section>
    <%- partial('_partial/explore-portals') %>
    <div class="explore-about-grid">
      <article class="explore-writing" aria-labelledby="exploreWritingTitle">
        <h2 id="exploreWritingTitle">关于这个博客</h2>
        <div class="explore-writing-copy"><%- page.content %></div>
        <a class="explore-guestbook-link" href="<%- url_for('/links/#guestbook') %>">给我留言 <span aria-hidden="true">↗</span></a>
      </article>
      <aside class="explore-principles" aria-labelledby="explorePrinciplesTitle">
        <h2 id="explorePrinciplesTitle">博客分类</h2>
        <ol>
          <li><span aria-hidden="true">01</span><p>项目</p></li>
          <li><span aria-hidden="true">02</span><p>阅读</p></li>
          <li><span aria-hidden="true">03</span><p>随笔</p></li>
        </ol>
      </aside>
    </div>
  </section>
</main>
<%- partial('_partial/document-end') %>
