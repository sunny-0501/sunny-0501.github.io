<%
  const allPosts = site.posts.sort('date', -1).toArray().filter((post) => post.archived !== true);
  const currentCategory = typeof page.category === 'string' ? page.category : '';
  const currentTag = typeof page.tag === 'string' ? page.tag : '';
  const preferredCategories = ['项目', '随笔', '阅读'];
  const categories = site.categories.toArray().map((category) => ({
    name: category.name, path: category.path,
    count: allPosts.filter((post) => post.categories.toArray().some((item) => item.name === category.name)).length
  })).filter((category) => category.count > 0).sort((first, second) => {
    const firstOrder = preferredCategories.indexOf(first.name);
    const secondOrder = preferredCategories.indexOf(second.name);
    return (firstOrder < 0 ? 99 : firstOrder) - (secondOrder < 0 ? 99 : secondOrder) || first.name.localeCompare(second.name, 'zh-CN');
  });
  const tags = site.tags.toArray().map((tag) => ({
    name: tag.name, path: tag.path,
    count: allPosts.filter((post) => post.tags.toArray().some((item) => item.name === tag.name)).length
  })).filter((tag) => tag.count > 0).sort((first, second) => first.name.localeCompare(second.name, 'zh-CN'));
  const taxonomy = typeof taxonomyView === 'string' ? taxonomyView : '';
  const initialKind = taxonomy || (currentCategory ? 'category' : currentTag ? 'tag' : page.year ? 'period' : 'posts');
  const initialName = currentCategory || currentTag || (page.year ? String(page.year) + (page.month ? '-' + String(page.month).padStart(2, '0') : '') : '');
  const postMatches = (post) => currentCategory ? post.categories.toArray().some((category) => category.name === currentCategory)
    : currentTag ? post.tags.toArray().some((tag) => tag.name === currentTag)
    : page.year ? date(post.date, page.month ? 'YYYY-MM' : 'YYYY') === initialName : true;
  const visiblePosts = allPosts.filter(postMatches);
  const postsPaneVisible = !taxonomy;
  const initialGroup = currentCategory ? 'categories' : currentTag ? 'tags' : taxonomy || 'posts';
  const initialLabel = taxonomy === 'categories' ? '文章分类' : taxonomy === 'tags' ? '文章标签' : currentCategory || (currentTag ? '# ' + currentTag : '') || (page.year ? initialName + ' 的文章' : '全部文章');
  const initialHint = taxonomy === 'categories' ? '共 ' + categories.length + ' 个分类 · 按主题继续阅读'
    : taxonomy === 'tags' ? '共 ' + tags.length + ' 个标签 · 从关键词出发'
    : (currentCategory ? currentCategory + ' · ' : currentTag ? '#' + currentTag + ' · ' : page.year ? initialName + ' · ' : '') + '共 ' + visiblePosts.length + ' 篇公开文章';
  const archiveRoutes = [
    { kind: 'posts', name: '', title: '文章', path: url_for('/archives/') },
    { kind: 'categories', name: '', title: '文章分类', path: url_for('/categories/') },
    { kind: 'tags', name: '', title: '文章标签', path: url_for('/tags/') },
    ...categories.map((category) => ({ kind: 'category', name: category.name, title: category.name, path: url_for(category.path) })),
    ...tags.map((tag) => ({ kind: 'tag', name: tag.name, title: '# ' + tag.name, path: url_for(tag.path) }))
  ];
  if (page.year) archiveRoutes.push({ kind: 'period', name: initialName, title: initialName + ' 的文章', path: url_for(page.path || '/archives/') });
  const totalWords = allPosts.reduce((sum, post) => sum + (post.content || '').replace(/<[^>]*>/g, ' ').replace(/&[^;]+;/g, ' ').replace(/\s+/g, '').length, 0);
  const oldestYear = allPosts.length ? new Date(allPosts[allPosts.length - 1].date).getFullYear() : new Date().getFullYear();
  const yearsWriting = Math.max(1, new Date().getFullYear() - oldestYear + 1);
  const tagCount = new Set(allPosts.flatMap((post) => post.tags.toArray().map((tag) => tag.name))).size;
  const categoryCount = new Set(allPosts.flatMap((post) => post.categories.toArray().map((category) => category.name))).size;
%>
<%- partial('_partial/document-start', { archiveView: true }) %>
<main class="inner-page archive-page" id="top" data-archive-shell data-archive-site-title="<%= config.title %>">
  <script type="application/json" id="archiveRoutes"><%- JSON.stringify(archiveRoutes).replace(/</g, '\\u003c') %></script>
  <section class="page-hero archive-hero" aria-labelledby="archiveTitle">
    <div class="archive-hero__content">
      <p class="eyebrow">ARCHIVE · <%= allPosts.length %> NOTES</p>
      <h1 id="archiveTitle" data-typewriter>把想法写下来，<br />就有了回声。</h1>
      <p data-typewriter>这里记录项目、阅读和日常里的片段。慢慢更新，也慢慢把自己说清楚。</p>
      <a class="archive-hero__link" href="#articles">开始浏览 <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="page-content article-page-grid archive-content" id="articles">
    <aside class="sidebar archive-author" aria-label="关于作者">
      <section class="sidebar-card profile-card archive-profile-card">
        <div class="profile-avatar"><img src="<%- url_for('/images/avatar.png') %>" alt="sunny 的头像" loading="lazy" /></div>
        <div class="profile-identity"><p class="mini-heading">ABOUT THE AUTHOR</p><h2>sunny</h2><i></i><span>INFJ · 林栖谷</span><p>一个在互联网行业工作、下班后写字的人。相信好奇心、长期主义，还有一杯热茶。</p></div>
        <div class="profile-socials"><a href="https://github.com/sunny-0501" target="_blank" rel="noopener noreferrer" aria-label="sunny 的 GitHub"><span aria-hidden="true">&lt;/&gt;</span></a></div>
        <a class="profile-more" href="<%- url_for('/explore/') %>">认识我更多 <span aria-hidden="true">↗</span></a>
      </section>
    </aside>
    <div class="articles-column archive-main">
      <nav class="archive-view-tabs" aria-label="文章浏览方式">
        <% [{ kind: 'posts', label: '全部文章', path: '/archives/', count: allPosts.length }, { kind: 'categories', label: '分类', path: '/categories/', count: categories.length }, { kind: 'tags', label: '标签', path: '/tags/', count: tags.length }].forEach(function (view) { %>
          <a class="archive-view-link<%= initialGroup === view.kind ? ' selected' : '' %>" data-archive-view-link="<%= view.kind %>" href="<%- url_for(view.path) %>"<%- initialGroup === view.kind ? ' aria-current="page"' : '' %>><span><%= view.label %></span><b><%= view.count %></b></a>
        <% }); %>
      </nav>
      <div class="section-heading archive-section-heading" id="archiveViewHeading" tabindex="-1">
        <h2 class="section-label"><span>JOURNAL</span><span id="archiveViewTitle"><%= initialLabel %></span></h2>
        <p class="filter-hint" id="filterHint" role="status" aria-live="polite"><%= initialHint %></p>
      </div>
      <section data-archive-pane="posts" aria-label="文章列表"<%- postsPaneVisible ? '' : ' hidden' %>>
        <nav class="content-tabs archive-tabs" aria-label="按分类筛选文章">
          <a class="<%= initialKind === 'posts' ? 'selected' : '' %>" data-archive-category-link="" href="<%- url_for('/archives/') %>"<%- initialKind === 'posts' ? ' aria-current="page"' : '' %>><span>全部</span><b><%= allPosts.length %></b></a>
          <% categories.forEach(function (category) { %>
            <a class="<%= currentCategory === category.name ? 'selected' : '' %>" data-archive-category-link="<%= category.name %>" href="<%- url_for(category.path) %>"<%- currentCategory === category.name ? ' aria-current="page"' : '' %>><span><%= category.name %></span><b><%= category.count %></b></a>
          <% }); %>
        </nav>
        <div class="article-list archive-article-list" id="articleList">
          <% allPosts.forEach(function (post) { %>
            <div class="archive-post" data-archive-post data-archive-categories="<%= JSON.stringify(post.categories.toArray().map((category) => category.name)) %>" data-archive-tags="<%= JSON.stringify(post.tags.toArray().map((tag) => tag.name)) %>" data-archive-period="<%= date(post.date, 'YYYY-MM') %>"<%- postMatches(post) ? '' : ' hidden' %>><%- partial('_partial/article-row', { posts: [post] }) %></div>
          <% }); %>
        </div>
        <p class="empty-state" id="emptyState"<%- visiblePosts.length ? ' hidden' : '' %>>没有找到匹配的文章。</p>
      </section>
      <section class="archive-taxonomy-panel" data-archive-pane="categories" aria-label="文章分类"<%- taxonomy === 'categories' ? '' : ' hidden' %>>
        <div class="taxonomy-grid archive-taxonomy-grid">
          <% categories.forEach(function (category) { %><a class="taxonomy-card" href="<%- url_for(category.path) %>"><span>CATEGORY</span><strong><%= category.name %></strong><p><%= category.count %> 篇文章</p><i aria-hidden="true">↗</i></a><% }); %>
        </div>
        <% if (!categories.length) { %><p class="empty-state">还没有公开文章分类。</p><% } %>
      </section>
      <section class="archive-taxonomy-panel" data-archive-pane="tags" aria-label="文章标签"<%- taxonomy === 'tags' ? '' : ' hidden' %>>
        <div class="tag-cloud archive-tag-cloud">
          <% tags.forEach(function (tag) { %><a class="tag-cloud__item" href="<%- url_for(tag.path) %>"><span># <%= tag.name %></span><b><%= tag.count %></b></a><% }); %>
        </div>
        <% if (!tags.length) { %><p class="empty-state">还没有公开文章标签。</p><% } %>
      </section>
    </div>
    <aside class="sidebar archive-sidebar" aria-label="站点信息与分类">
      <section class="sidebar-card archive-stat-card" aria-labelledby="archiveStatsTitle">
        <h2 class="archive-card-title" id="archiveStatsTitle">站点统计</h2>
        <dl class="archive-stat-list">
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>文章</dt><dd><%= allPosts.length %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h6l2 2h10v11H3Z"/></svg>分类</dt><dd><%= categoryCount %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h9l9 9-8 8-10-10Z"/><circle cx="7.5" cy="8.5" r="1"/></svg>标签</dt><dd><%= tagCount %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>总字数</dt><dd><%= totalWords.toLocaleString('zh-CN') %></dd></div>
          <div><dt><svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18M7 15h3"/></svg>记录年数</dt><dd><%= yearsWriting %><small> 年</small></dd></div>
        </dl>
      </section>
      <nav class="sidebar-card archive-topic-card" aria-label="按分类浏览">
        <p class="mini-heading">BROWSE BY TOPIC</p>
        <div class="archive-topic-links">
          <a href="<%- url_for('/archives/') %>"><span>全部文章</span><b><%= allPosts.length %></b></a>
          <% categories.forEach(function (category) { %>
            <a href="<%- url_for(category.path) %>" data-archive-topic="<%= category.name %>"<%- currentCategory === category.name ? ' aria-current="page"' : '' %>><span><%= category.name %></span><b><%= category.count %></b></a>
          <% }); %>
        </div>
        <div class="archive-index-links"><a href="<%- url_for('/categories/') %>">浏览所有分类 <span aria-hidden="true">↗</span></a><a href="<%- url_for('/tags/') %>">浏览所有标签 <span aria-hidden="true">↗</span></a></div>
      </nav>
      <div class="sidebar-card archive-aside-note"><p class="mini-heading">KEEP IN TOUCH</p><p>如果你喜欢这里的文字，可以订阅 RSS，在下一次更新时再相遇。</p><a class="side-link" href="<%- url_for('/rss/') %>">订阅更新 ↗</a></div>
    </aside>
  </section>
</main>
<%- partial('_partial/document-end') %>
