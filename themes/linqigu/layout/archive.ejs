<% const posts = page.posts ? page.posts.toArray() : site.posts.sort('date', -1).toArray(); %>
<%- partial('_partial/document-start') %>
<main class="inner-page" id="top">
  <div class="status-bar"><span>文章归档</span><strong>把零散的想法，整理成可以回看的路</strong><a href="<%- url_for('/') %>" aria-label="回到首页">↗</a></div>
  <section class="page-hero archive-hero"><div><p class="eyebrow">ARCHIVE · <%= posts.length %> NOTES</p><h1><%= page.title || '把想法写下来，' %><br />就有了回声。</h1><p>这里记录项目、阅读和随笔里的片段。慢慢更新，也慢慢把自己说清楚。</p></div><div class="page-hero-symbol" aria-hidden="true">02</div></section>
  <section class="page-content article-page-grid" id="articles"><div class="articles-column"><nav class="content-tabs" aria-label="文章分类"><a href="<%- url_for('/archives/') %>">全部</a><a href="<%- url_for('/categories/项目/') %>">项目</a><a href="<%- url_for('/categories/随笔/') %>">随笔</a><a href="<%- url_for('/categories/阅读/') %>">阅读</a></nav><div class="section-heading"><div class="section-label"><span>02</span><span><%= page.title || '全部文章' %></span><span class="line"></span></div><div class="filters" role="group" aria-label="文章分类"><button class="filter-button active" type="button" data-filter="all">全部</button><button class="filter-button" type="button" data-filter="项目">项目</button><button class="filter-button" type="button" data-filter="阅读">阅读</button><button class="filter-button" type="button" data-filter="随笔">随笔</button></div></div><div class="article-list" id="articleList"><%- partial('_partial/article-row', { posts: posts }) %></div><p class="empty-state" id="emptyState" hidden>没有找到匹配的文章。</p></div><aside class="sidebar"><div class="sidebar-card profile-card"><p class="mini-heading">KEEP READING</p><h2>从一篇开始。</h2><p>不必一次读完所有内容，挑一篇现在想看的就好。</p><a class="side-link" href="<%- url_for('/') %>">回到首页 ↗</a></div></aside></section>
</main>
<%- partial('_partial/document-end') %>
