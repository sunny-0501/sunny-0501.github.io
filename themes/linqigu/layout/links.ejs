<%
  const friendSites = Array.isArray(site.data.friends) ? site.data.friends : [];
  const neighbors = friendSites.filter((friend) => friend.kind === 'blog');
  const inspirations = friendSites.filter((friend) => friend.kind !== 'blog');
  const friendIllustrations = ['gallery-poppy-hill.jpg', 'header-landscape.png', 'explore-moving-castle.jpg', 'guestbook-country-house.jpg'];
  const siteInfo = '名称：' + config.title + '\n地址：' + config.url.replace(/\/$/, '') + '/\n简介：' + config.description + '\n头像：' + config.url.replace(/\/$/, '') + url_for('/images/avatar.png');
%>
<%- partial('_partial/document-start', { friendsView: true }) %>
<main class="inner-page friends-page harbor-page" id="top">
  <div class="harbor-location"><a href="<%- url_for('/') %>">首页</a><span aria-hidden="true">/</span><span>友链</span></div>
  <section class="harbor-intro" aria-labelledby="harborTitle">
    <div class="harbor-intro__copy">
      <h1 id="harborTitle">友链</h1>
      <p class="harbor-intro__description">我平时会看的几个博客。也欢迎来交换链接。</p>
      <nav class="harbor-intro__anchors" aria-label="友链页内容"><a href="#neighbors">博客列表 <span aria-hidden="true">↓</span></a><a href="#guestbook">留言 <span aria-hidden="true">↗</span></a></nav>
    </div>
    <figure class="harbor-intro__picture">
      <img src="<%- url_for('/images/links-cottage.jpg') %>" alt="绿树掩映下的乡间小屋，阳光洒在通往院子的路上" width="960" height="640" fetchpriority="high" />
      <figcaption><span>GHIBLI HOUSEBOAT</span><span>友链与留言</span></figcaption>
      <span class="harbor-postmark" aria-hidden="true"><span>風の便り</span><small>HELLO, NEIGHBOR</small></span>
    </figure>
  </section>
  <section class="harbor-neighbors" id="neighbors" aria-labelledby="neighborsTitle">
    <div class="harbor-section-heading"><div><h2 id="neighborsTitle">推荐博客</h2></div><p><%= neighbors.length %> 个站点 · 点击打开</p></div>
    <div class="harbor-friends">
      <% neighbors.forEach(function(friend, index) { %>
        <a class="harbor-friend" href="<%= friend.url %>" target="_blank" rel="noopener noreferrer">
          <span class="harbor-friend__scene" aria-hidden="true"><img src="<%- url_for('/images/' + friendIllustrations[index % friendIllustrations.length]) %>" alt="" loading="lazy" width="400" height="120" /><span class="harbor-friend__number"><%= String(index + 1).padStart(2, '0') %></span><small>画舫配图</small></span>
          <span class="harbor-friend__identity"><span class="harbor-friend__avatar"><span aria-hidden="true"><%= friend.name.slice(0, 1) %></span><% if (friend.avatar) { %><img src="<%= friend.avatar %>" alt="" loading="lazy" width="48" height="48" /><% } %></span><span><strong><%= friend.name %></strong><small><%= friend.note || '个人博客' %></small></span></span>
          <p><%= friend.description %></p>
          <span class="harbor-friend__visit">访问博客 <span aria-hidden="true">↗</span></span>
        </a>
      <% }); %>
    </div>
    <% if (!neighbors.length) { %><p class="harbor-empty">还在整理，欢迎在下方留下你的博客。</p><% } %>
  </section>
  <div class="harbor-voyage" id="voyage"><%- partial('_partial/voyage') %></div>
  <% if (inspirations.length) { %>
  <section class="harbor-inspirations" aria-labelledby="inspirationTitle">
    <div class="harbor-section-heading"><div><h2 id="inspirationTitle">常用网站</h2></div><p>工具和内容收藏</p></div>
    <div class="harbor-bookmarks"><% inspirations.forEach(function(friend, index) { %><a href="<%= friend.url %>" target="_blank" rel="noopener noreferrer"><span class="harbor-bookmark__index"><%= String(index + 1).padStart(2, '0') %></span><span><strong><%= friend.name %></strong><small><%= friend.description %></small></span><span aria-hidden="true">↗</span></a><% }); %></div>
  </section>
  <% } %>
  <section class="harbor-exchange" aria-labelledby="friendsApplyTitle">
    <div class="harbor-exchange__copy"><h2 id="friendsApplyTitle">交换友链</h2><p>先添加本站，再把你的站名、网址、简介和头像发给我。</p><a class="harbor-email" href="mailto:2522015679@qq.com?subject=%E5%8F%8B%E9%93%BE%E7%94%B3%E8%AF%B7%20%C2%B7%20%E5%90%89%E5%8D%9C%E5%8A%9B%E7%94%BB%E8%88%AB">邮件申请 <span aria-hidden="true">↗</span></a><span class="harbor-exchange__or">也可以在下方留言申请。</span></div>
    <div class="harbor-sitecard"><span class="harbor-sitecard__tag">本站信息</span><div class="harbor-sitecard__brand"><img src="<%- url_for('/images/ghibli-houseboat-logo.svg') %>" alt="" width="48" height="48" /><div><strong><%= config.title %></strong><span>sunny 的个人博客</span></div></div><pre id="friendSiteInfo"><%= siteInfo %></pre><button class="harbor-copy" type="button" data-copy-site aria-describedby="siteCopyStatus">复制本站信息 <span aria-hidden="true">⧉</span></button><p id="siteCopyStatus" role="status" aria-live="polite">申请请附：名称、网址、简介与头像。</p></div>
    <p class="harbor-exchange__note">欢迎以原创为主、还在更新的个人博客。我会确认网站能正常访问后添加。</p>
  </section>
  <%- partial('_partial/guestbook-note') %>
</main>
<%- partial('_partial/document-end') %>
