<%
  const albums = (site.data.gallery && site.data.gallery.albums) || [];
%>
<%- partial('_partial/document-start', { galleryView: true }) %>
<%- partial('_partial/gallery-shell-start', { title: '相册', description: '插画、壁纸和博客素材。', isAlbum: false }) %>
<section class="gallery-library" aria-labelledby="galleryTitle">
  <header class="gallery-page-heading">
    <span class="gallery-title-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="17" height="16" rx="2"/><path d="M7 15l3-4 2.2 2.6L15 10l3 5H7Z"/><path d="M7 2h14a2 2 0 0 1 2 2v12"/></svg></span>
    <div><h2 id="galleryTitle">相册</h2><p>共 <%= albums.length %> 个相册</p></div>
  </header>
  <label class="gallery-search">
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
    <input id="gallerySearch" type="search" aria-label="搜索相册" placeholder="搜索相册..." autocomplete="off" />
  </label>
  <div class="gallery-filters" role="group" aria-label="相册分类">
    <button class="gallery-filter" type="button" data-gallery-filter="all" aria-pressed="true">全部</button>
    <button class="gallery-filter" type="button" data-gallery-filter="wallpaper" aria-pressed="false">壁纸</button>
    <button class="gallery-filter" type="button" data-gallery-filter="illustration" aria-pressed="false">插画</button>
  </div>
  <div class="gallery-album-list">
    <% albums.forEach(function (album) {
      const photos = album.photos || [];
      const categories = [...new Set(photos.flatMap((photo) => photo.categories || []))].join(' ');
      const searchText = [album.title, album.description, ...(album.tags || []), ...photos.map((photo) => [photo.title, photo.search].join(' '))].join(' ');
    %>
      <article class="gallery-album" data-gallery-album data-gallery-category="<%= categories %>" data-gallery-search="<%= searchText %>">
        <a class="gallery-album-card" href="<%- url_for('/gallery/' + album.slug + '/') %>" aria-label="打开相册：<%= album.title %>，共 <%= photos.length %> 张照片">
          <span class="gallery-album-cover">
            <img src="<%- url_for(album.cover) %>" alt="<%= album.title %>封面" loading="lazy" />
            <span class="gallery-album-count"><%= photos.length %> 张照片</span>
            <span class="gallery-album-copy"><strong><%= album.title %></strong><span><%= album.description %></span></span>
            <span class="gallery-album-chevron" aria-hidden="true">↗</span>
          </span>
          <span class="gallery-album-meta"><% (album.tags || []).forEach(function (tag) { %><span><%= tag %></span><% }); %></span>
        </a>
      </article>
    <% }); %>
  </div>
  <p class="gallery-empty" id="galleryEmpty" role="status" hidden>没有找到符合条件的相册</p>
</section>
<%- partial('_partial/gallery-shell-end') %>
<%- partial('_partial/document-end') %>
